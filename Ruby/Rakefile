# frozen_string_literal: true

require 'bundler/gem_tasks'
require 'shellwords'

APP_NAME   = 'terminal-notifier.app'
VENDOR_DIR = 'vendor/terminal-notifier'
BINARY     = "#{VENDOR_DIR}/#{APP_NAME}/Contents/MacOS/terminal-notifier"

desc 'Remove the vendored binary'
task :clean do
  # Scoped to the vendored app only: `vendor/` is also where `bundle install`
  # puts gems when a path is configured.
  rm_rf VENDOR_DIR
  rm_f Dir.glob('*.gem')
end

desc 'Build the application bundle and vendor it into the gem'
task :update_build do
  rm_rf VENDOR_DIR
  mkdir_p VENDOR_DIR

  sh 'cd .. && xcodebuild -project "Terminal Notifier.xcodeproj" ' \
     '-scheme "Terminal Notifier" -configuration Release SYMROOT=build build'

  cp_r "../build/Release/#{APP_NAME}", VENDOR_DIR
  chmod 0o755, BINARY

  # The published gem serves every Mac from a single upload, so a thin binary
  # here would silently ship an Intel-only or arm-only tool.
  archs = `lipo -info #{BINARY.shellescape}`
  %w[x86_64 arm64].each do |arch|
    raise "vendored binary is missing the #{arch} slice: #{archs}" unless archs.include?(arch)
  end
  puts "vendored #{archs.strip}"
end

desc 'Build gem'
task :gem => :update_build do
  sh 'gem build terminal-notifier.gemspec'
end

desc 'Run specs'
task :spec do
  sh 'bundle exec rspec'
end

task :default => :spec
